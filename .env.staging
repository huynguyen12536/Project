# ============================================================================
# LearnHub LMS - Staging Environment Non-Secret Configuration
# Safe to commit — contains NO secrets or passwords
# Secrets are injected via CI/CD GitHub Secrets at deploy time
# ============================================================================

SPRING_PROFILES_ACTIVE=staging
NODE_ENV=production
LOG_LEVEL=INFO
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_LEARNHUB=INFO

# ---- Application URLs ----
FRONTEND_URL=http://staging.learnhub.local
CORS_ALLOWED_ORIGINS=http://staging.learnhub.local,http://staging.learnhub.local:3000
VITE_API_BASE_URL=http://staging.learnhub.local/api
GITHUB_OAUTH_REDIRECT_URI=http://staging.learnhub.local/api/v1/oauth/github/callback

# ---- Database config (non-secret portion) ----
DATABASE_NAME=learnhub_staging
DATABASE_USER=learnhub_staging
DATABASE_PORT=5432

# ---- Redis config ----
REDIS_PORT=6379

# ---- Token Settings ----
RSA_KEY_VERSION=1
TOKEN_VERIFICATION_EXPIRY_HOURS=24
TOKEN_RESET_EXPIRY_HOURS=24

# ---- Security Settings ----
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_URL=http://staging.learnhub.local:3001

# ---- Nginx ports ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- JVM Tuning (staging mirrors prod at reduced scale) ----
JAVA_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled -XX:InitialHeapSize=256M -XX:MaxHeapSize=1G

# ---- PostgreSQL Tuning (staging) ----
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_CONNECTIONS=100

# ---- Deployment metadata ----
DEPLOYMENT_ENV=staging
DEPLOYMENT_REGION=local
