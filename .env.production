# LearnHub Production Environment Configuration
# Production Deployment - Phase 5

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_NAME=learnhub_prod
DATABASE_USER=learnhub_prod
DATABASE_PASSWORD=<CHANGE_ME_SECURE_PASSWORD>
DATABASE_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/learnhub_prod

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# SPRING BOOT CONFIGURATION
# ============================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# ============================================
# LLM API CONFIGURATION (Anthropic Claude)
# ============================================
# REQUIRED: Get from https://console.anthropic.com
LLM_API_KEY=sk-ant-<YOUR_ANTHROPIC_API_KEY>

# Optional: Override default Claude model
LLM_MODEL=claude-3-5-sonnet-20241022

# LLM timeout (seconds)
LLM_TIMEOUT_SECONDS=10

# Max tokens per LLM response
LLM_MAX_TOKENS=1000

# LLM API endpoint
LLM_ENDPOINT=https://api.anthropic.com/v1/messages

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_PORT=3000
NODE_ENV=production
VITE_API_BASE_URL=https://api.learnhub.com/api

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://learnhub.com,https://www.learnhub.com

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO

# ============================================
# JVM CONFIGURATION
# ============================================
# Tune JVM for production workloads
JAVA_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled -XX:InitialHeapSize=512M -XX:MaxHeapSize=2G

# ============================================
# GITHUB OAUTH (Optional - if using GitHub auth)
# ============================================
GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>

# ============================================
# RSA KEY FOR JWT SIGNING (Optional)
# ============================================
RSA_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n<YOUR_RSA_PRIVATE_KEY>\n-----END RSA PRIVATE KEY-----

# ============================================
# BACKEND PORT (Internal)
# ============================================
BACKEND_PORT=8080

# ============================================
# DEPLOYMENT METADATA
# ============================================
DEPLOYMENT_ENV=production
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_VERSION=5.0.0
DEPLOYMENT_DATE=2026-06-19

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit this file to version control
# 2. Store DATABASE_PASSWORD in secrets manager (AWS Secrets, HashiCorp Vault, etc.)
# 3. Store LLM_API_KEY in secrets manager
# 4. Store GITHUB_CLIENT_SECRET in secrets manager
# 5. Rotate all credentials regularly
# 6. Use TLS/HTTPS for all external connections
# 7. Enable VPC security groups to restrict access
