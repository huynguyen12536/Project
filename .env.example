# LearnHub Environment Configuration Template
# Copy this file to .env and fill in with actual values
# DO NOT commit .env with sensitive values to version control

# ==================
# Database
# ==================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learnhub
SPRING_DATASOURCE_USERNAME=learnhub
SPRING_DATASOURCE_PASSWORD=learnhubpass

# ==================
# Redis
# ==================
REDIS_URL=redis://localhost:6379

# ==================
# JWT / RSA Keys
# ==================
RSA_KEY_VERSION=1

# ==================
# GitHub OAuth Configuration
# REQUIRED: Register app at https://github.com/settings/developers
# ==================
GITHUB_OAUTH_CLIENT_ID=<your-github-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<your-github-client-secret>

# Redirect URI must match exactly what's registered in GitHub app settings
# Dev: http://localhost:8080/api/v1/oauth/github/callback
# Staging: https://staging.learnhub.com/api/v1/oauth/github/callback
# Production: https://learnhub.com/api/v1/oauth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/oauth/github/callback

# Secret for HMAC hashing of GitHub tokens (must be secure, random 32+ bytes)
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_SECRET=<your-secure-random-secret-for-token-hashing>

# Encryption key for GitHub refresh tokens (must be exactly 32 bytes for AES-256)
# Stored as Base64 or hex string. Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=<your-secure-random-32-byte-encryption-key>

# ==================
# Email Configuration
# ==================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-gmail-address>
MAIL_PASSWORD=<your-gmail-app-password>
MAIL_FROM=noreply@learnhub.local

# ==================
# Application URLs
# ==================
FRONTEND_URL=http://localhost:3000

# ==================
# Token Expiry Configuration
# ==================
TOKEN_VERIFICATION_EXPIRY_HOURS=24
TOKEN_RESET_EXPIRY_HOURS=24

# ==================
# Security Configuration
# ==================
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
