# ============================================================================
# LearnHub LMS - Environment Configuration Template
# Copy to .env and fill in actual values for local development
# NEVER commit .env with real secrets to version control
# ============================================================================

# ============================================================================
# DATABASE (PostgreSQL 16)
# ============================================================================
DATABASE_NAME=learnhub
DATABASE_USER=postgres
DATABASE_PASSWORD=dev_password
DATABASE_PORT=5432

# Used by Spring Boot (docker-compose sets these via SPRING_DATASOURCE_*)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learnhub
SPRING_DATASOURCE_USERNAME=learnhub
SPRING_DATASOURCE_PASSWORD=dev_password

# ============================================================================
# REDIS 7
# ============================================================================
REDIS_PASSWORD=dev_password
REDIS_PORT=6379
REDIS_URL=redis://:dev_password@localhost:6379

# ============================================================================
# SPRING BOOT
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=DEBUG
LOGGING_LEVEL_ROOT=INFO

# ============================================================================
# JWT / RSA KEYS
# Dev: leave blank — the app auto-generates RSA keys on startup
# Prod: generate with: openssl genrsa -out private.pem 2048
# ============================================================================
RSA_KEY_VERSION=1
RSA_PRIVATE_KEY_PEM=

# ============================================================================
# GITHUB OAUTH
# Register at: https://github.com/settings/developers
# Dev callback: http://localhost:8080/api/v1/oauth/github/callback
# ============================================================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/oauth/github/callback

# Token signing secret (HMAC-SHA256) — must be 32+ bytes
# Generate: openssl rand -hex 32
GITHUB_TOKEN_SECRET=

# AES-256 token encryption key — must be exactly 32 bytes (base64 or hex)
# Generate: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# EMAIL (Gmail SMTP)
# Use an App Password, not your regular password
# Guide: https://support.google.com/accounts/answer/185833
# ============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@learnhub.local

# ============================================================================
# APPLICATION URLS
# ============================================================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================================
# SECURITY
# ============================================================================
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
TOKEN_VERIFICATION_EXPIRY_HOURS=24
TOKEN_RESET_EXPIRY_HOURS=24

# ============================================================================
# MONITORING
# ============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_URL=http://localhost:3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ============================================================================
# PORTS (override defaults if needed)
# ============================================================================
BACKEND_PORT=8080
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# DEPLOYMENT (CI/CD)
# These are used in scripts/deploy-blue-green.sh
# ============================================================================
BACKEND_IMAGE=ghcr.io/your-org/learnhub-backend
FRONTEND_IMAGE=ghcr.io/your-org/learnhub-frontend

# ============================================================================
# PostgreSQL tuning (dev defaults)
# Prod: shared_buffers=8GB, effective_cache_size=24GB
# ============================================================================
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_CONNECTIONS=200
